<resources>
    <style name="Theme.TodoApp.QuickAdd" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <!-- The date and time pickers opened from here, in the app's colours. -->
        <item name="android:colorAccent">@color/ledger_accent</item>
        <item name="android:colorControlActivated">@color/ledger_accent</item>
        <item name="android:colorBackgroundFloating">@color/ledger_panel</item>
        <item name="android:textColorPrimary">@color/ledger_ink</item>
    </style>
    <!-- An invisible screen that only shows a dialog (CompleteAskActivity). -->
    <style name="Theme.TodoApp.Translucent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
