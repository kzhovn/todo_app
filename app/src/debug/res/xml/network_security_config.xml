<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets a local server on the dev machine (the emulator sees it as 10.0.2.2)
     be tested without TLS. Everything else, and every release build, stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
