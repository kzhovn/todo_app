[Unit]
Description=Raspberry todo server: sync, web app, top-bar API and Discord bot
After=network-online.target
Wants=network-online.target

[Service]
User=todo
WorkingDirectory=/var/lib/todo
EnvironmentFile=/etc/todo-server.env
ExecStart=/opt/todo/server/bin/server
# The JVM exits 143 on SIGTERM, which is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
